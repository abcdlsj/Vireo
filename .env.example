# Copy to .env. Everything here is optional except a provider key and a model.

# --- Signing in (the cloud) ---
# A GitHub OAuth app (github.com/settings/developers), with the callback URL
# <cloud address>/auth/github/callback, e.g. http://localhost:8700/auth/github/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Or sign in by name, with no password. Only on a machine nobody else can reach.
# VIREO_DEV_LOGIN=1

# --- Provider keys, read by LiteLLM (set the ones you use) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# --- Models, as LiteLLM names them (provider/model) ---
# Main model for conversations and agent work, and a cheaper one for routine
# work such as titles and memory upkeep. Both can also be changed in Settings.
VIREO_MODEL=anthropic/claude-sonnet-4-5
VIREO_FAST_MODEL=anthropic/claude-haiku-4-5

# --- Talking to an endpoint directly instead of LiteLLM ---
# VIREO_LLM_BASE_URL=https://api.openai.com/v1
# VIREO_LLM_API_KEY=sk-...

# Key Vireo uses to reach LiteLLM; change it if LiteLLM is reachable by others.
LITELLM_MASTER_KEY=sk-vireo-local
TZ=UTC
