{
  "name": "vireo",
  "version": "0.1.0",
  "description": "A self-hosted personal agent that runs every matter in its own thread and remembers its owner.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "apps/host",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -k -n host,web \"npm:dev:host\" \"npm:dev:web\"",
    "dev:host": "tsx watch --env-file-if-exists=.env apps/host/src/index.ts",
    "dev:web": "npm run dev -w @vireo/web",
    "build": "npm run build:web && npm run build:host",
    "build:web": "npm run build -w @vireo/web",
    "build:host": "npm run build -w @vireo/host",
    "start": "node scripts/start.mjs",
    "host": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning apps/host/dist/index.js",
    "app": "node apps/web/serve.mjs",
    "pair": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning apps/host/dist/pair.js",
    "typecheck": "npm run typecheck --workspaces",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "acceptance": "npm run build && node scripts/acceptance.mjs",
    "deploy": "scripts/deploy.sh"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
