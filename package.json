{
  "name": "vireo",
  "version": "0.1.0",
  "description": "A self-hosted personal agent that runs every matter in its own thread and remembers its owner.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --env-file-if-exists=.env server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build --config web/vite.config.ts",
    "build:server": "tsc -p server/tsconfig.json",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "acceptance": "npm run build && node scripts/acceptance.mjs",
    "host": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning dist/server/index.js",
    "app": "node web/serve.mjs",
    "deploy": "scripts/deploy.sh",
    "pair": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning dist/server/pair.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@mozilla/readability": "^0.6.0",
    "@openai/agents": "^0.19.0",
    "hono": "^4.13.13",
    "linkedom": "^0.18.13",
    "openai": "^7.30.1",
    "playwright": "1.56.1",
    "typebox": "^1.1.24",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "dompurify": "^3.4.16",
    "marked": "^18.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
