{
  "name": "@vireo/cloud",
  "version": "0.1.0",
  "description": "Vireo cloud: GitHub sign-in, the nodes each account owns, access tokens, and the relay between the app and nodes. Runs on Cloudflare Workers or as a Node server.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "main": "dist/node/index.js",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json",
    "start": "node --disable-warning=ExperimentalWarning dist/node/index.js",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "hono": "^4.13.13",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261010.1",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.1",
    "@vireo/protocol": "*",
    "typescript": "^7.0.2",
    "wrangler": "^4.149.0"
  }
}
