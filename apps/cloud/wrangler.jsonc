// The Vireo cloud on Cloudflare Workers. From apps/cloud:
//
//   npx wrangler login
//   npx wrangler d1 create vireo-cloud          # paste its database_id below
//   npx wrangler secret put GITHUB_CLIENT_SECRET
//   npx wrangler secret put GOOGLE_CLIENT_SECRET   # for the shared Google client,
//                                                  # whose id goes in vars below
//   npx wrangler deploy
//
// Tables are made on first use, and the key that signs node tokens is made
// and kept in D1. Each node's relay socket lives in a NodeRelay Durable
// Object, which hibernates while nothing is in flight.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "vireo-cloud",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "routes": [{ "pattern": "cloud.askvireo.com", "custom_domain": true }],
  "vars": {
    "VIREO_CLOUD_URL": "https://cloud.askvireo.com",
    "VIREO_WEB_URL": "https://app.askvireo.com",
    // More app origins allowed to call the cloud, comma-separated (e.g. Vercel previews).
    "VIREO_WEB_ORIGINS": "",
    // The GitHub OAuth app's client id; its secret is set with `wrangler secret
    // put GITHUB_CLIENT_SECRET`. Both this and the D1 database id below belong
    // to one deployment: a deployment of your own pastes its own values here.
    // This repository's own are kept out of it — scripts/cloud-config.mjs
    // writes them from the environment into wrangler.deploy.jsonc, which is
    // git-ignored and is what the deployment pipeline deploys.
    "GITHUB_CLIENT_ID": "PASTE_YOUR_GITHUB_CLIENT_ID",
    // Vireo's shared Google OAuth client, for the Google plugin when a node
    // owner has none of their own; empty switches it off. Its secret is set
    // with `wrangler secret put GOOGLE_CLIENT_SECRET`. Like the GitHub id, a
    // deployment of your own can keep the id out of the repository:
    // scripts/cloud-config.mjs fills it from VIREO_GOOGLE_CLIENT_ID.
    "GOOGLE_CLIENT_ID": "PASTE_YOUR_GOOGLE_CLIENT_ID"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "vireo-cloud", "database_id": "PASTE_YOUR_D1_DATABASE_ID" }],
  "durable_objects": { "bindings": [{ "name": "RELAY", "class_name": "NodeRelay" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NodeRelay"] }],
  "observability": { "enabled": true },
  // `wrangler dev` on the cloud's usual port, clear of a node's 8787.
  "dev": { "port": 8700 }
}
