// Cloudflare Workers static assets: `npm run build && npx wrangler deploy`
// from apps/web. The app lives on app.askvireo.com; askvireo.com is the
// website (apps/site). worker/index.ts hands the cloud's paths (/api, /auth,
// /n, /.well-known) to the cloud Worker (vireo-cloud) over a service binding,
// so the app reaches the cloud on its own origin; build it with
// VITE_VIREO_SAME_ORIGIN=1 to use that. Cloudflare Pages works too (build
// command `npm run build`, output `dist`, without the binding);
// public/_headers applies to both.
{
  "name": "vireo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "routes": [{ "pattern": "app.askvireo.com", "custom_domain": true }],
  "services": [{ "binding": "CLOUD", "service": "vireo-cloud" }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/n/*", "/.well-known/*"]
  }
}
