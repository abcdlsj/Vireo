#!/usr/bin/env node
// A stand-in for the tailscale CLI used by tests: a two-machine tailnet where
// every machine's ports are served by 127.0.0.1.
import fs from "node:fs";
import net from "node:net";
const args = process.argv.slice(2).filter((a) => !a.startsWith("--socket="));
const peers = {
  n1: { ID: "n1", HostName: "nas", DNSName: "nas.tail-test.ts.net.", OS: "linux", TailscaleIPs: ["100.64.0.2"], Online: true, Tags: ["tag:server"] },
  n2: { ID: "n2", HostName: "old-laptop", DNSName: "old-laptop.tail-test.ts.net.", OS: "windows", TailscaleIPs: ["100.64.0.3"], Online: false, LastSeen: "2026-09-01T10:00:00Z" },
};
switch (args[0]) {
  case "status":
    process.stdout.write(
      JSON.stringify({
        BackendState: "Running",
        Self: { ID: "n0", HostName: "vireo", DNSName: "vireo.tail-test.ts.net.", OS: "linux", TailscaleIPs: ["100.64.0.1"], Online: true },
        Peer: peers,
        CurrentTailnet: { Name: "owner@example.com" },
      }),
    );
    break;
  case "ping":
    console.log(`pong from nas (${args.at(-1)}) via 192.168.1.5:41641 in 2ms`);
    break;
  case "nc": {
    const sock = net.connect(Number(args[2]), "127.0.0.1");
    process.stdin.pipe(sock).pipe(process.stdout);
    sock.on("error", (e) => {
      console.error(e.message);
      process.exit(1);
    });
    sock.on("close", () => process.exit(0));
    break;
  }
  case "serve":
    // FAKE_TS_SERVE_GATE: a file that must exist before HTTPS counts as allowed.
    if (process.env.FAKE_TS_SERVE_GATE && !fs.existsSync(process.env.FAKE_TS_SERVE_GATE)) {
      console.log("Serve is not enabled on your tailnet.\nTo enable, visit:\n\n         https://login.tailscale.com/f/serve?node=n0\n");
      const wait = setInterval(() => {
        if (fs.existsSync(process.env.FAKE_TS_SERVE_GATE)) {
          clearInterval(wait);
          process.exit(0);
        }
      }, 100);
      break;
    }
    console.log(`Available within your tailnet:\n\nhttps://vireo.tail-test.ts.net/\n|-- proxy ${args.at(-1)}\n\nServe started and running in the background.\nTo disable the proxy, run: tailscale serve --https=443 off`);
    break;
  default:
    break;
}
