# Cloud settings, read by the Vireo cloud.

# Where the app is served (Vercel...). Node links open it, and GitHub sign-in
# returns to it. More origins allowed to call this cloud, comma-separated:
VIREO_WEB_URL=https://vireo.example.com
# VIREO_WEB_ORIGINS=https://vireo-git-main.example.vercel.app

# A GitHub OAuth app (github.com/settings/developers) whose callback URL is
# https://<VIREO_DOMAIN>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
