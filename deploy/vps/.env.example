# Deployment settings for deploy/vps/compose.yaml. Host settings (model keys)
# go in host.env.

# Join your tailnet and serve this host at https://vireo.<tailnet>.ts.net,
# reachable from your own devices only: no domain, no open port, no Caddy.
# The log shows a Tailscale sign-in link; after signing in, the pairing link.
VIREO_TAILSCALE=1
# Keep the host's port off the public internet when Tailscale is how you reach it.
VIREO_BIND=127.0.0.1

# Optional services next to the host, comma-separated: https (Caddy, needs
# VIREO_DOMAIN), app (the UI on this server), litellm. Empty: the host alone.
COMPOSE_PROFILES=

# Optional. With the https profile, Caddy gets a certificate for this domain
# (its DNS must point at this server) and the host is reached at it.
# VIREO_DOMAIN=vireo.example.com

# Where the Vireo app is served (Vercel, Cloudflare...). The host then prints
# a link that opens the app and pairs in one step.
# VIREO_APP_URL=https://vireo.vercel.app

# Name paired apps show for this host.
# VIREO_NAME=vps

# Images to run. scripts/deploy.sh uses a build synced over SSH instead.
# VIREO_IMAGE=ghcr.io/abcdlsj/vireo-host:latest
# VIREO_WEB_IMAGE=ghcr.io/abcdlsj/vireo-web:latest

# The UI on this server (profile "app"): address and port it listens on.
# VIREO_APP_BIND=0.0.0.0
# VIREO_APP_PORT=8780

# Port the host is published on, and on which address (0.0.0.0 to open it
# to the internet, e.g. without Tailscale).
# VIREO_PORT=8787
# Address the host is reached at, if not https://VIREO_DOMAIN
# (e.g. https://vps.tailnet.ts.net or your own proxy's domain).
# VIREO_PUBLIC_URL=
TZ=UTC
