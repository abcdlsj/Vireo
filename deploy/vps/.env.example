# Deployment settings for deploy/vps/compose.yaml. Cloud settings (app
# address, GitHub OAuth app) go in cloud.env; a node's in node.env.

# The cloud's domain. Its DNS must point at this server; Caddy gets the
# certificate. Nodes connect to https://<this>, and the app calls it.
VIREO_DOMAIN=cloud.vireo.example.com

# Optional services, comma-separated: node (a node of yours on this server),
# litellm. Empty: the cloud and Caddy only.
COMPOSE_PROFILES=

# Name of the node on this server, as the app lists it.
# VIREO_NAME=vps

# Images to run. scripts/deploy.sh uses a build synced over SSH instead.
# VIREO_CLOUD_IMAGE=ghcr.io/abcdlsj/vireo-cloud:latest
# VIREO_NODE_IMAGE=ghcr.io/abcdlsj/vireo-node:latest
TZ=UTC
