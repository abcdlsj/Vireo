# Settings for a node on this server (profile "node"), read by the node and
# by LiteLLM when its profile is on. All optional: the model can also be set
# in Settings → Model.

# Any OpenAI-compatible endpoint:
VIREO_LLM_BASE_URL=https://api.openai.com/v1
VIREO_LLM_API_KEY=sk-...
# VIREO_MODEL=
# VIREO_FAST_MODEL=

# Or through LiteLLM (profile "litellm"):
# VIREO_LLM_BASE_URL=http://litellm:4000/v1
# VIREO_LLM_API_KEY=sk-vireo-local
# LITELLM_MASTER_KEY=sk-vireo-local
# ANTHROPIC_API_KEY=
# VIREO_MODEL=anthropic/claude-sonnet-4-5
# VIREO_FAST_MODEL=anthropic/claude-haiku-4-5
